# Local deploy configuration — copy to `.env` and fill in.
# `.env` is git-ignored and never committed. Explicit environment
# variables override these values.
#
# SSH target for the Home Assistant host (matches your `homeassistant`
# alias; override per-run with TARGET=... or the positional arg).
TARGET=homeassistant

# Long-lived access token (HA Profile -> Security -> Long-Lived Access
# Tokens). Used to raise the "Restart required" Repairs issue after
# backend deploys. Without it, the script prints the manual restart
# command instead.
HA_TOKEN=
